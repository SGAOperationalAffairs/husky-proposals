# Copy to .env.local for local development. Never commit real values.
# Every variable is validated in src/env.ts; the server refuses to start if one is missing.

# local | test | preview | dev | production
APP_ENV=local

# Neon Postgres (T0.4, T0.5). Optional until the app first queries. DATABASE_URL is the pooled
# connection (host with -pooler); DIRECT_URL is the direct one, used for migrations.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/db?sslmode=require
# DIRECT_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/db?sslmode=require

# 1 turns on the development sign-in stand-in (T0.6). Only allowed when APP_ENV is local or test.
AUTH_STAND_IN=1
