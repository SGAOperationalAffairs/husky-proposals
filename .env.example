# Environment variables. Copy this file to .env.local for local development.
# Never commit real values. src/env.ts checks every variable when the server starts,
# and the server refuses to start if a required one is missing or a forbidden one is set.
#
# Three environments:
#   local       your laptop (npm run dev). Values go in .env.local.
#   dev         dev.proposals, the SGA test site. Values go in Vercel's dev environment.
#   production  proposals.northeasternsga.com. Values go in Vercel's production environment.
#
# Each variable says what it needs in each environment: required, optional, or not allowed.

# Which environment this is. Vercel sets this for dev and production. Locally, keep local.
APP_ENV=local

# --- Database (Neon Postgres) ---
# local: optional. With no URL, the ideas pages show the playground's sample ideas.
# dev: required. The app refuses to start without DATABASE_URL.
# production: required. The app refuses to start without DATABASE_URL.
# DATABASE_URL is the pooled connection (the host contains -pooler). The app uses it at runtime.
# DIRECT_URL is the direct connection. Migrations use it, so set it wherever you run migrations.
# Use a Neon branch that holds test data for local. Never point local at production.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/db?sslmode=require
# DIRECT_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/db?sslmode=require

# --- Sign-in ---
# Use one option per environment. The validator blocks the wrong one.
#
# local: AUTH_STAND_IN=1 signs you in as a fake user with the role you pick. Not allowed in dev or production.
# dev: AUTH_SGAUTH=1 signs in through SGAuth. SGAUTH_URL and SGAUTH_COOKIE_NAME are required with it.
#      Not allowed locally or in production until SGAuth is deployed (T2.5).
#      dev.proposals and proposals-dev must read both SGAuth values from the same row, or the browser loops.
# production: leave both unset. Sign-in is not ready for production until T2.5.
AUTH_STAND_IN=1
# AUTH_SGAUTH=1
# SGAUTH_URL=https://dev.auth.northeasternsga.com
# SGAUTH_COOKIE_NAME=__Secure-sgauth-dev.session_token

# --- Tests only ---
# The test harness reads these from your shell, not from .env.local, because Vitest does not load this file.
# Locally, only localhost is accepted for TEST_DATABASE_URL.
# TEST_DATABASE_URL=postgresql://localhost:5432/postgres
# TEST_DATABASE_ALLOWED_HOSTS=ep-example-test.us-east-2.aws.neon.tech
