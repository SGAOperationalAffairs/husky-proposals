# Copy to .env.local for local development. Never commit real values.
# Every variable is validated in src/env.ts; the server refuses to start if one is missing.

# local | test | preview | dev | production
APP_ENV=local

# Neon Postgres (T0.4, T0.5). DATABASE_URL is required outside local and test (#60); with
# APP_ENV local or test and no URL, the ideas pages show the playground's sample ideas.
# DATABASE_URL is the pooled connection (host with -pooler); DIRECT_URL is the direct one,
# used for migrations.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/db?sslmode=require
# DIRECT_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/db?sslmode=require

# Database tests only (#104). A local Postgres; each run creates and drops its own database there.
# Vitest does not read .env.local, so export this in your shell. Only localhost is accepted locally.
# TEST_DATABASE_URL=postgresql://localhost:5432/postgres

# 1 turns on the development sign-in stand-in (T0.6). Only allowed when APP_ENV is local or test.
AUTH_STAND_IN=1

# SGAuth sign-in (#177). Off by default, and allowed only when APP_ENV is dev, so it is
# never set locally. dev.proposals sets APP_ENV=dev and AUTH_SGAUTH=1. dev.proposals and
# proposals-dev must read both SGAuth values from the same row, or the browser loops.
# AUTH_SGAUTH=1
# SGAUTH_URL=https://dev.auth.northeasternsga.com
# SGAUTH_COOKIE_NAME=__Secure-sgauth-dev.session_token
